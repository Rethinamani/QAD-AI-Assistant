# ── Project Paths ──────────────────────────────────────────
PROJECT_ROOT=.
DATA_DIR=./data
UPLOADS_DIR=./data/uploads
PROCESSED_DIR=./data/processed
NIGHTLY_DROP_DIR=./data/nightly_drop
FIGURES_DIR=./data/figures
LOGS_DIR=./logs

# ── ChromaDB ───────────────────────────────────────────────
CHROMA_PERSIST_DIR=./vectorstore/chroma_db
CHROMA_COLLECTION_PDF=pdf_chunks
CHROMA_COLLECTION_EXCEL=excel_errors
CHROMA_COLLECTION_SERVICENOW=servicenow_tickets

# ── Document Registry ──────────────────────────────────────
REGISTRY_DB_PATH=./registry/document_registry.db

# ── Ollama ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Retrieval ──────────────────────────────────────────────
TOP_K_DENSE=20
TOP_K_BM25=20
TOP_K_AFTER_FUSION=10
TOP_K_FINAL=5
CONFIDENCE_HIGH=0.75
CONFIDENCE_LOW=0.40

# ── Memory ─────────────────────────────────────────────────
MEMORY_WINDOW_SIZE=5

# ── Guardrails ─────────────────────────────────────────────
MAX_QUERY_LENGTH=500
MAX_RESPONSE_TOKENS=400

# ── Security ───────────────────────────────────────────────
SENSITIVITY_HIGH_KEYWORDS=salary,payroll,confidential,executive,password,credential